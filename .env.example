# Copie este archivo como .env y ajuste los valores. NO suba nunca .env al repositorio.

# --- General ---------------------------------------------------------------
APP_ENV=production                 # development | production
SECRET_KEY=                        # obligatorio en producción: python -c "import secrets;print(secrets.token_hex(32))"
DATA_DIR=/data                     # base de datos, archivos y temporales (use un volumen cifrado)
PUBLIC_BASE_URL=https://video.ejemplo.es   # necesario para los enlaces de consentimiento
CORS_ORIGINS=                      # vacío si la PWA se sirve desde el mismo dominio

# --- Límites ---------------------------------------------------------------
MAX_UPLOAD_MB=1024
MAX_DIALOGUE_SECONDS=120
ALLOW_4K=false
ALLOW_MINORS=false                 # dejar en false salvo análisis jurídico específico
SESSION_DAYS=14

# --- Conservación de datos ---------------------------------------------------
RETENTION_DAYS=30                  # proyectos sin actividad se borran automáticamente (0 = nunca)
TEMP_RETENTION_HOURS=24
CONSENT_LINK_DAYS=7

# --- Cola de trabajos --------------------------------------------------------
INLINE_WORKER=true                 # false si ejecuta "python -m app.worker" aparte
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=600
CHUNK_SECONDS=10

# --- Detección facial (sólo valida las fotos de las personas) -------------------
FACE_DETECTOR=auto                 # auto | yunet | haar
# https://github.com/opencv/opencv_zoo/tree/main/models/face_detection_yunet (MIT)
YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx

# --- Guion y prompts (Claude, de Anthropic) -------------------------------------
# Sin clave se usa el modo básico local (divide las instrucciones en escenas, sin IA).
LLM_PROVIDER=auto                  # auto | anthropic | basic
ANTHROPIC_API_KEY=                 # https://console.anthropic.com/ — de pago por uso
ANTHROPIC_MODEL=claude-opus-5-5
MAX_SCENES=12

# --- Imágenes y vídeo con IA (fal.ai) -------------------------------------------
# Sin clave se usa el modo local: filtros OpenCV, composición y animática FFmpeg (sin IA generativa).
# Las condiciones de fal.ai exigen consentimiento escrito para usar la imagen de una persona real:
# la app sólo envía fotos de personas con consentimiento vigente registrado.
IMAGE_PROVIDER=auto                # auto | fal | local
VIDEO_PROVIDER=auto                # auto | fal | local
FAL_KEY=                           # https://fal.ai/dashboard/keys
FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana/edit          # retratos y fotogramas con referencias de cara
FAL_IMAGE_MODEL=fal-ai/nano-banana                    # personajes ficticios sin foto
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video   # clips de 5 o 10 s
FAL_IMAGE_COST=0.04                # USD por imagen (revise https://fal.ai/pricing)
FAL_VIDEO_COST_PER_SECOND=0.05     # USD por segundo de vídeo (revise https://fal.ai/pricing)
FAL_POLL_SECONDS=4
FAL_TIMEOUT_SECONDS=1200

# --- Síntesis de voz -----------------------------------------------------------
ESPEAK_BINARY=                     # autodetecta espeak-ng
PIPER_COMMAND=                     # autodetecta "piper"; admite plantilla con {model} {output} {length_scale}
PIPER_VOICES_DIR=/models/piper     # archivos *.onnx + *.onnx.json (revise el MODEL_CARD de cada voz)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=              # id:Nombre,id2:Nombre2 (sólo voces de catálogo autorizadas)
ELEVENLABS_COST_PER_1K_CHARS=0.30

# --- Subtítulos automáticos ------------------------------------------------------
ASR_PROVIDER=none                  # none | faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# --- Procedencia C2PA ------------------------------------------------------------
C2PA_TOOL=                         # autodetecta c2patool
C2PA_SIGN_CERT=                    # cadena de certificados PEM (sin ella: certificado de pruebas)
C2PA_PRIVATE_KEY=
C2PA_ALG=es256

# --- Render ------------------------------------------------------------------------
FONT_PATH=                         # autodetecta DejaVu Sans Bold
RENDER_PRESET=medium

# --- Red de salida (descarga de resultados de fal.ai) -------------------------------
HTTP_USER_AGENT=EstudioIA/0.3 (+https://video.ejemplo.es/contacto)
OUTBOUND_PROXY=                    # proxy HTTP de salida (recomendado: que bloquee también redes privadas)
ALLOW_PRIVATE_NETWORKS=false       # SOLO desarrollo; la app no arranca con true en producción
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_REDIRECTS=5

# --- Aislamiento de FFmpeg -------------------------------------------------------------
MEDIA_CPU_SECONDS=3600             # límite de CPU por subproceso
MEDIA_MAX_FILE_MB=8192             # tamaño máximo de archivo que puede escribir un subproceso
