# Copie este archivo como .env y ajuste los valores. NO suba nunca .env al repositorio.

# --- General ---------------------------------------------------------------
APP_ENV=production                 # development | production
SECRET_KEY=                        # obligatorio en producción: python -c "import secrets;print(secrets.token_hex(32))"
DATA_DIR=/data                     # base de datos, archivos y temporales (use un volumen cifrado)
PUBLIC_BASE_URL=https://video.ejemplo.es   # necesario para enlaces de consentimiento y sync.so
CORS_ORIGINS=                      # vacío si la PWA se sirve desde el mismo dominio

# --- Límites ---------------------------------------------------------------
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=600
MAX_DIALOGUE_SECONDS=120
ALLOW_4K=false
ALLOW_MINORS=false                 # dejar en false salvo análisis jurídico específico
SESSION_DAYS=14

# --- Conservación de datos ---------------------------------------------------
RETENTION_DAYS=30                  # proyectos sin actividad se borran automáticamente (0 = nunca)
TEMP_RETENTION_HOURS=24
CONSENT_LINK_DAYS=7

# --- Cola de trabajos --------------------------------------------------------
INLINE_WORKER=true                 # false si ejecuta "python -m app.worker" aparte (p. ej. en la máquina con GPU)
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=600
CHUNK_SECONDS=10

# --- Detección facial ----------------------------------------------------------
FACE_DETECTOR=auto                 # auto | yunet | haar
# https://github.com/opencv/opencv_zoo/tree/main/models/face_detection_yunet (MIT)
YUNET_MODEL_PATH=/models/face_detection_yunet_2023mar.onnx

# --- Sustitución facial (InsightFace: modelos SOLO uso no comercial salvo licencia) ---
FACESWAP_PROVIDER=none             # none | insightface
INSIGHTFACE_MODEL_ROOT=/models/insightface      # contiene models/buffalo_l
INSWAPPER_MODEL_PATH=/models/inswapper_128.onnx
INSIGHTFACE_LICENSE_ACK=false      # true sólo si su uso es no comercial o tiene licencia de InsightFace
FACESWAP_DEVICE=cpu                # cpu | cuda
FACESWAP_SECONDS_PER_SECOND_CPU=12
FACESWAP_SECONDS_PER_SECOND_GPU=1.5

# --- Sincronización labial ----------------------------------------------------
LIPSYNC_PROVIDER=none              # none | sync_so | command
SYNC_API_KEY=
SYNC_MODEL=lipsync-2
SYNC_COST_PER_SECOND=0.05          # revise https://sync.so/pricing
SYNC_SECONDS_PER_SECOND=3
# Modelo local (ejemplos; ajuste rutas y revise la licencia de cada modelo):
# Wav2Lip (sólo uso no comercial):
# LIPSYNC_COMMAND=python /opt/Wav2Lip/inference.py --checkpoint_path /models/wav2lip_gan.pth --face {video} --audio {audio} --outfile {output}
# LatentSync (revise LICENSE del repositorio; ~8-18 GB de VRAM):
# LIPSYNC_COMMAND=python -m scripts.inference --unet_config_path configs/unet/stage2.yaml --inference_ckpt_path checkpoints/latentsync_unet.pt --video_path {video} --audio_path {audio} --video_out_path {output}
LIPSYNC_COMMAND=
LIPSYNC_COMMAND_LICENSE=
LIPSYNC_COMMAND_SECONDS_PER_SECOND=20

# --- Síntesis de voz -----------------------------------------------------------
ESPEAK_BINARY=                     # autodetecta espeak-ng
PIPER_COMMAND=                     # autodetecta "piper"; admite plantilla con {model} {output} {length_scale}
PIPER_VOICES_DIR=/models/piper     # archivos *.onnx + *.onnx.json (revise el MODEL_CARD de cada voz)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=              # id:Nombre,id2:Nombre2 (sólo voces de catálogo autorizadas)
ELEVENLABS_COST_PER_1K_CHARS=0.30

# --- Subtítulos automáticos ------------------------------------------------------
ASR_PROVIDER=none                  # none | faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# --- Procedencia C2PA ------------------------------------------------------------
C2PA_TOOL=                         # autodetecta c2patool
C2PA_SIGN_CERT=                    # cadena de certificados PEM (sin ella: certificado de pruebas)
C2PA_PRIVATE_KEY=
C2PA_ALG=es256

# --- Render ------------------------------------------------------------------------
FONT_PATH=                         # autodetecta DejaVu Sans Bold
RENDER_PRESET=medium

# --- Importación desde Internet (v0.2) ------------------------------------------------
ENABLED_CONNECTORS=wikimedia,internet_archive,pexels,vimeo,youtube,direct_url
HTTP_USER_AGENT=EstudioIA/0.2 (+https://video.ejemplo.es/contacto; admin@ejemplo.es)   # Wikimedia exige identificarse
OUTBOUND_PROXY=                    # proxy HTTP de salida (recomendado: que bloquee también redes privadas)
ALLOW_PRIVATE_NETWORKS=false       # SOLO desarrollo; la app no arranca con true en producción
DOWNLOAD_TIMEOUT_SECONDS=60
MAX_REDIRECTS=5
PEXELS_API_KEY=                    # gratuita: https://www.pexels.com/api/
VIMEO_ACCESS_TOKEN=                # token con permiso video_files (sólo vídeos cuyo propietario permite descarga)
YOUTUBE_API_KEY=                   # YouTube Data API v3: SOLO búsqueda y metadatos (YouTube no permite descargar)

# --- Aislamiento de FFmpeg -------------------------------------------------------------
MEDIA_CPU_SECONDS=3600             # límite de CPU por subproceso
MEDIA_MAX_FILE_MB=8192             # tamaño máximo de archivo que puede escribir un subproceso
